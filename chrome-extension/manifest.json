{
  "manifest_version": 3,
  "name": "Screen Recorder & Capture Pro",
  "version": "2.0.0",
  "description": "Professional screen recording and capture tool with advanced features, area selection, and high-quality output",
  "permissions": [
    "activeTab",
    "desktopCapture",
    "storage",
    "downloads",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background-new.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup-new.html",
    "default_title": "Screen Recorder & Capture Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["area-selector.js", "popup-new.css", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "start-recording": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Start/Stop screen recording"
    },
    "capture-screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Capture screenshot"
    },
    "capture-area": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Capture selected area"
    }
  }
}
