{
  "manifest_version": 3,
  "name": "Screen Recorder & Capture Pro",
  "version": "3.0.0",
  "description": "Professional screen recording and capture tool with advanced annotation, editing, and sharing features",
  "permissions": [
    "activeTab",
    "desktopCapture",
    "storage",
    "downloads",
    "tabs",
    "scripting",
    "notifications",
    "clipboardRead",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background-new.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup-new.html",
    "default_title": "Screen Recorder & Capture Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "area-selector.js",
        "annotation-overlay.js",
        "image-editor.js",
        "full-page-capture.js",
        "sharing-integration.js",
        "effects-processor.js",
        "stamp-library.js",
        "pdf-export.js",
        "gif-creator.js",
        "popup-new.css",
        "annotation.css",
        "editor.css",
        "history.html",
        "history.js",
        "web-app.html",
        "icons/*",
        "assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "start-recording": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Start/Stop screen recording"
    },
    "capture-screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Capture screenshot"
    },
    "capture-area": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Capture selected area"
    }
  }
}
